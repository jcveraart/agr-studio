# Optional. Copy to .env.local and enter your own key. Never commit .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Alternatively run Ollama locally and set the name of a model you installed.
OLLAMA_MODEL=
PORT=4177
# Optional Strava app credentials. Prefer the local Strava connection form.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
